generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * =========================================================
 * SHOPIFY SESSION
 * =========================================================
 */

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)

  refreshToken        String?
  refreshTokenExpires DateTime?
}

/**
 * =========================================================
 * MARKTBLATT PAKETE / ABONNEMENTS
 * =========================================================
 */

model Subscription {
  id String @id @default(cuid())

  // Shopify-Kunde
  customerId    String  @unique
  customerEmail String?

  // Aktuelles Marktblatt-Paket
  package      String
  productLimit Int

  // Abo-Status
  status String @default("active")

  // Streich-/Vergleichspreise auf Marktblatt anzeigen
  compareAtPricesEnabled Boolean @default(true)

  // Stripe-Daten
  stripeCustomerId     String?
  stripeSubscriptionId String? @unique

  // Laufzeit
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?

  // Verwaltung
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * =========================================================
 * ANBIETERPROFIL
 * =========================================================
 * Zentrale Informationen eines Anbieters.
 * Diese Daten gehören nicht zu einem einzelnen Produkt.
 * Beim Veröffentlichen werden die benötigten Angaben
 * automatisch in die Produkt-Metafelder übernommen.
 */

model VendorProfile {
  id String @id @default(cuid())

  /**
   * Eigentümer / Shopify-Kunde
   */

  customerId    String  @unique
  customerEmail String?

  /**
   * Vom Anbieter gepflegte Informationen
   */

  companyDescription String?

  // Shopify File GID des Hintergrundbildes.
  // Beispiel:
  // gid://shopify/MediaImage/123456789
  backgroundImageId String?

  discountCode String?

  // Prozentwert, z. B. 10 für 10 %
  discountPercent Int?

  // Zunächst als String, passend zu unserem bisherigen
  // Umgang mit Geldwerten und der vorhandenen
  // Produkt-Metafelddefinition.
  discountMinimumOrderValue String?

// Allgemeine Lieferzeit des Anbieters.
// Gilt für alle Produkte dieses Anbieters.
deliveryTimeInfo String?

  /**
   * Automatisch ermittelbare Anbieterinformationen
   */

  homepageUrl   String?
  imprintUrl    String?
  withdrawalUrl String?
  facebookUrl   String?
  instagramUrl  String?
  tiktokUrl     String?
  youtubeUrl    String?

  /**
   * Verwaltung
   */

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
}

/**
 * =========================================================
 * MARKTBLATT PRODUKTE
 * =========================================================
 */

model MarketplaceProduct {
  id String @id @default(cuid())

  /**
   * Eigentümer / Anbieter
   */

  customerId    String
  customerEmail String?

  /**
   * Produktdaten
   */

  title       String
  description String?

  price    String?
  currency String?

  vendor String?
  brand  String?

  // Erkannter Streich-/Vergleichspreis
  compareAtPrice       String?
  compareAtPriceSource String?

  /**
   * Zusätzliche Produktdaten
   */

  sku      String?
  gtin     String?
  mpn      String?
  category String?

  // Standardisierte Shopify Product Taxonomy
  shopifyTaxonomyId   String?
  shopifyTaxonomyName String?

  // Offizielle, validierte Shopify-Kategorieattribute.
  // Beispiel:
  // [
  //   {
  //     "attributeName": "Color",
  //     "values": [
  //       {
  //         "id": "gid://shopify/TaxonomyValue/4",
  //         "name": "Gold"
  //       }
  //     ]
  //   }
  // ]
  shopifyTaxonomyAttributes Json?

  productType String?
  material    String?
  color       String?
  size        String?

  /**
   * SEO / Meta-Daten
   */

  metaTitle       String?
  metaDescription String?

  /**
   * Google / Merchant Produktdaten
   */

  condition   String?
  gender      String?
  ageGroup    String?
  adult       Boolean?
  itemGroupId String?

  /**
   * Ursprüngliche Produktseite beim Anbieter
   */

  sourceUrl String

  /**
   * Produktbilder
   * Werden zunächst als JSON-String gespeichert.
   */

  images String?

  /**
   * Marktblatt-Status
   * Mögliche Werte:
   * active
   * inactive
   * draft
   * deleted
   */

  status String @default("active")

  /**
   * =======================================================
   * SHOPIFY VERKNÜPFUNG
   * =======================================================
   */

  // Shopify Product GID
  // Beispiel:
  // gid://shopify/Product/123456789

  shopifyProductId String? @unique

  // Shopify Variant GID
  // Beispiel:
  // gid://shopify/ProductVariant/123456789

  shopifyVariantId String? @unique

  /**
   * Shopify Handle
   * Beispiel:
   * armband-18k-gold-charm-bambus
   */

  shopifyHandle String?

  /**
   * =======================================================
   * VERWALTUNG
   * =======================================================
   */

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /**
   * INDEXE
   */

  @@index([customerId])
  @@index([status])
  @@index([sourceUrl])
}
